{
  "name": "unactivity-smm-manager",
  "version": "1.0.0",
  "description": "Desktop GUI для управления Unactivity SMM",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build-win": "electron-builder --win"
  },
  "build": {
    "appId": "com.unactivity.smm",
    "productName": "Unactivity SMM Manager",
    "win": {
      "target": "portable"
    },
    "files": [
      "main.js",
      "renderer.js",
      "index.html",
      "styles.css",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    }
  },
  "dependencies": {
    "axios": "^1.6.0",
    "simple-git": "^3.20.0"
  },
  "devDependencies": {
    "electron": "^27.0.0",
    "electron-builder": "^24.6.4"
  }
}
